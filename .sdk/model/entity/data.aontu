# Entity: data

main: kit: entity: data: {

  alias: field: {}

  fields: {
    bytes: {
      h: "Bytes"
      n: "bytes"
      r: true
      sh: "Number of bytes you passed to the endpoint"
      t: "`$NUMBER`"
    }
    cleanerThan: {
      h: "Cleaner Than"
      n: "cleanerThan"
      r: true
      sh: "A numeric value between 0 and 1 representing the percentage of pages that this result's emissions are lower than."
      t: "`$NUMBER`"
    }
    gco2e: {
      h: "Gco2e"
      n: "gco2e"
      r: true
      sh: "The emissions in grams of CO2 equivalent"
      t: "`$NUMBER`"
    }
    green: {
      h: "Green"
      n: "green"
      r: true
      sh: "The green hosting flag you passed to the endpoint"
      t: "`$BOOLEAN`"
    }
    rating: {
      h: "Rating"
      n: "rating"
      r: true
      sh: "The Digital Carbon Rating"
      t: "`$STRING`"
    }
    statistics: {
      h: "Statistics"
      n: "statistics"
      r: true
      sh: "Statistics object containing detailed calculations."
      t: "`$OBJECT`"
    }
  }

  name: "data"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /data"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 12345678
                k: "query"
                n: "byte"
                or: "bytes"
                r: true
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "green"
                or: "green"
                r: true
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "legacy"
                or: "legacy"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/data"
          q: {
            exist: [
              "byte"
              "green"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "data"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
